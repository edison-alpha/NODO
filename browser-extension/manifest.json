{
  "manifest_version": 3,
  "name": "nodo Download Engine",
  "version": "0.2.0",
  "description": "Send links and videos from the browser to the nodo download app running on this computer.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "optional_permissions": ["cookies", "downloads"],
  "host_permissions": ["http://127.0.0.1:47283/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["floating.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "nodo",
    "default_popup": "popup.html"
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
